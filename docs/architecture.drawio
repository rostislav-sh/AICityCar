<mxfile host="app.diagrams.net"><diagram id="arch" name="Архитектура"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1470" pageHeight="820"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Анализ работы отдела продаж — архитектура&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="700" height="30" as="geometry"/></mxCell><mxCell id="frame" value="Фоновые задачи: Celery + Redis" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#9E9E9E;fontColor=#616161;verticalAlign=top;labelPosition=center;verticalLabelPosition=top;align=center;html=1;" vertex="1" parent="1"><mxGeometry x="315" y="95" width="270" height="560" as="geometry"/></mxCell><mxCell id="amo" value="&lt;b&gt;amoCRM API v4&lt;/b&gt;&lt;br&gt;сделки, задачи, события,&lt;br&gt;примечания о звонках" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="90" as="geometry"/></mxCell><mxCell id="tel" value="&lt;b&gt;API телефонии&lt;/b&gt;&lt;br&gt;записи и журнал звонков" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="220" height="80" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;CRM Sync (каждые 15–30 мин)&lt;/b&gt;&lt;br&gt;aiohttp, инкрементально&lt;br&gt;по updated_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="240" height="90" as="geometry"/></mxCell><mxCell id="stt" value="&lt;b&gt;Speech-to-Text (ежедневно)&lt;/b&gt;&lt;br&gt;Whisper / SpeechKit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="335" width="240" height="70" as="geometry"/></mxCell><mxCell id="qc" value="&lt;b&gt;Проверка качества&lt;/b&gt;&lt;br&gt;распознавания" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="240" height="60" as="geometry"/></mxCell><mxCell id="callq" value="&lt;b&gt;Call Quality Agent (LLM)&lt;/b&gt;&lt;br&gt;скрипт, ошибки, возражения,&lt;br&gt;причина отказа → JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="240" height="80" as="geometry"/></mxCell><mxCell id="human" value="&lt;b&gt;Ручная проверка&lt;/b&gt;&lt;br&gt;сотрудник слушает запись&lt;br&gt;и заполняет ту же форму" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="220" height="90" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;leads&lt;br&gt;tasks&lt;br&gt;users&lt;br&gt;lead_status_history&lt;br&gt;calls (+ статус обработки)&lt;br&gt;call_analysis&lt;br&gt;reports" style="shape=cylinder3;boundedLbl=1;size=14;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="270" width="230" height="290" as="geometry"/></mxCell><mxCell id="an" value="&lt;b&gt;Analytics (SQL, без LLM)&lt;/b&gt;&lt;br&gt;конверсия, суммы, источники,&lt;br&gt;просрочки, причины отказа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="300" width="240" height="90" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;Report Agent (LLM)&lt;/b&gt;&lt;br&gt;цифры — в шаблон кодом,&lt;br&gt;LLM — только выводы,&lt;br&gt;проверка чисел" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="450" widt